PORT=8080
DATA_DIR=./data
PRODUCTS_DIR=../products
DRY_RUN=true
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_REGION=global
NOMAD_NAMESPACE=default
# Production ACL/mTLS deployments should inject these as mounted secrets.
# NOMAD_TOKEN=
# NOMAD_CACERT=/run/secrets/nomad/ca.pem
# NOMAD_CLIENT_CERT=/run/secrets/nomad/client.pem
# NOMAD_CLIENT_KEY=/run/secrets/nomad/client-key.pem
PACKAGING_API_URL=http://127.0.0.1:8080
# RustFS exposes an S3-compatible API; MINIO_* is the existing application
# configuration namespace, not a requirement to run MinIO.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=rustfsadmin
MINIO_SECRET_KEY=rustfsadmin
MINIO_BUCKET=packaging-artifacts
# Override these when the Docker daemon is remote (for example: RUSTFS_HOST_PORT=19000).
RUSTFS_HOST_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ENDPOINT=127.0.0.1:9000
# For a remote Docker context, use the remote host endpoint here and set the
# integration endpoint to its Docker-host-visible address (often 127.0.0.1:PORT).
RUSTFS_INTEGRATION_ENDPOINT=
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# Required for AUTH_ENABLED=true with DRY_RUN=false. Keep these only in the
# Conductor environment. Nomad Variables render a bearer and one-time execution
# capability as files under NOMAD_SECRETS_DIR (Linux 0400; Windows allocation ACL).
# Never add either to runner.env, Task.Env, CLI output, reports, or an image.
AUTH_ENABLED=false
AUTH_RUNNER_TOKEN=
PACKAGING_API_TOKEN_FILE=vela-runner-auth
RUNNER_CAPABILITY_TTL_SECONDS=900
# Reserved for per-execution capability signing; never pass this to Runner tasks.
RUNNER_EXECUTION_HMAC_KEY=
# Human operator/admin bearer only for runner_e2e_cli.py --live and Windows API reachability.
# This is not a runner credential and must not be supplied to a runner task.
PACKAGING_OPERATOR_TOKEN=
