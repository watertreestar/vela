PORT=8080
DATA_DIR=./data
PRODUCTS_DIR=../products
DRY_RUN=true
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_REGION=global
NOMAD_NAMESPACE=default
PACKAGING_API_URL=http://127.0.0.1:8080
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=packaging-artifacts
# Required for AUTH_ENABLED=true with DRY_RUN=false. Keep this only in the
# Conductor environment; Nomad renders it into each allocation's secrets directory.
AUTH_ENABLED=false
AUTH_RUNNER_TOKEN=
PACKAGING_API_TOKEN_FILE=vela-runner-auth
RUNNER_CAPABILITY_TTL_SECONDS=900
# Reserved for per-execution capability signing; never pass this to Runner tasks.
RUNNER_EXECUTION_HMAC_KEY=
